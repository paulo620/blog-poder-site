---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
---

<BaseLayout
  title="Home"
  description="Aprenda por que sua pequena empresa precisa de um site para atrair mais clientes e crescer na internet."
>
  <HeroSection />

  <section class="featured-posts">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">// Conteúdo</span>
        <h2 class="section-title">Artigos Recentes</h2>
        <p class="section-desc">Dicas práticas para colocar seu negócio na internet</p>
      </header>

      <div class="posts-grid">
        {posts.map(post => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={post.id}
            image={post.data.image}
          />
        ))}
      </div>

      <div class="see-all">
        <a href="/blog" class="btn btn-ghost">Ver todos os artigos →</a>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container">
      <div class="cta-card">
        <span class="eyebrow">// Próximo passo</span>
        <h2 class="cta-title">Pronto para ter um site profissional?</h2>
        <p class="cta-desc">Entre em contato e veja como podemos transformar sua presença digital.</p>
        <a href="/contato" class="btn btn-primary">Solicitar orçamento grátis</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .featured-posts {
    padding: 80px 0;
  }

  .section-header {
    margin-bottom: 40px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .section-title {
    font-family: var(--f-display);
    font-weight: var(--fw-bold);
    font-size: var(--fs-h2);
    letter-spacing: var(--ls-heading);
    color: var(--text);
  }

  .section-desc {
    color: var(--text-2);
    font-size: 1.05rem;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .see-all {
    display: flex;
    justify-content: center;
    margin-top: 40px;
  }

  /* ── CTA ── */
  .cta-section {
    padding: 0 0 80px;
  }

  .cta-card {
    background: var(--g-2);
    backdrop-filter: var(--g-blur);
    -webkit-backdrop-filter: var(--g-blur);
    border: 1px solid var(--g-border);
    border-radius: var(--r-lg);
    box-shadow: var(--g-shadow-card);
    padding: 56px 48px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
  }

  .cta-title {
    font-family: var(--f-display);
    font-weight: var(--fw-bold);
    font-size: var(--fs-h2);
    letter-spacing: var(--ls-heading);
    color: var(--text);
    max-width: 540px;
  }

  .cta-desc {
    color: var(--text-2);
    font-size: 1.05rem;
    max-width: 420px;
    margin-bottom: 8px;
  }

  @media (max-width: 768px) {
    .posts-grid { grid-template-columns: 1fr; }
    .cta-card { padding: 40px 24px; }
  }

  @media (min-width: 641px) and (max-width: 968px) {
    .posts-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
