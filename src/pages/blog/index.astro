---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout
  title="Blog"
  description="Artigos sobre marketing digital e a importância de ter um site para pequenas empresas."
>
  <div class="blog-page">
    <div class="container">
      <header class="page-header">
        <span class="eyebrow">// Blog</span>
        <h1 class="page-title">Artigos</h1>
        <p class="page-desc">Dicas para ajudar sua empresa a crescer na internet</p>
      </header>

      <div class="posts-grid">
        {posts.map(post => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={post.id}
            image={post.data.image}
          />
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .blog-page { padding: 56px 0 80px; }

  .page-header {
    margin-bottom: 40px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .page-title {
    font-family: var(--f-display);
    font-weight: var(--fw-extrabold);
    font-size: var(--fs-display);
    letter-spacing: var(--ls-display);
    color: var(--text);
  }

  .page-desc {
    color: var(--text-2);
    font-size: 1.1rem;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  @media (max-width: 768px) {
    .posts-grid { grid-template-columns: 1fr; }
  }

  @media (min-width: 641px) and (max-width: 968px) {
    .posts-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
