---
const year = new Date().getFullYear();

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog' },
  { label: 'Sobre', href: '/sobre' },
  { label: 'Contato', href: '/contato' },
];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <a href="/" class="footer-logo" aria-label="Ir para a página inicial">
      O poder de um site
    </a>

    <p class="footer-tagline">Ajudando pequenas empresas a crescerem na internet.</p>

    <nav aria-label="Links do rodapé">
      <ul class="footer-links">
        {navLinks.map(link => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <p class="footer-copy">© {year} O poder de um site. Todos os direitos reservados.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 80px;
    padding: 48px 0 32px;
    background: var(--g-1);
    backdrop-filter: var(--g-blur);
    -webkit-backdrop-filter: var(--g-blur);
    border-top: 1px solid var(--g-border-dim);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
  }

  .footer-logo {
    font-family: var(--f-display);
    font-weight: var(--fw-extrabold);
    font-size: 1.25rem;
    letter-spacing: var(--ls-tight);
    color: var(--text);
    text-decoration: none;
  }

  .footer-logo:hover { color: var(--text); }

  .dot { color: var(--c-purple); }

  .footer-tagline {
    font-size: 0.9rem;
    color: var(--text-3);
    max-width: 320px;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 24px;
  }

  .footer-links a {
    font-family: var(--f-display);
    font-weight: var(--fw-semibold);
    font-size: 0.875rem;
    color: var(--text-2);
    transition: color var(--t-fast);
  }

  .footer-links a:hover { color: var(--c-teal-fg); }

  .footer-copy {
    font-size: 0.8rem;
    color: var(--text-3);
    padding-top: 20px;
    border-top: 1px solid var(--g-border-dim);
    width: 100%;
    text-align: center;
  }
</style>
