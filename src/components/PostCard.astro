---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  image?: string;
}

const { title, description, pubDate, slug, image } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('pt-BR', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---

<article class="post-card">
  <a href={`/blog/${slug}`} class="post-card-link" aria-label={`Ler artigo: ${title}`}>
    <div class="post-card-image">
      {image
        ? <img src={image} alt={title} loading="lazy" />
        : <div class="post-card-placeholder" aria-hidden="true"></div>
      }
    </div>
    <div class="post-card-body">
      <time class="post-card-date" datetime={pubDate.toISOString()}>{formattedDate}</time>
      <h3 class="post-card-title">{title}</h3>
      <p class="post-card-desc">{description}</p>
      <span class="post-card-read">Ler artigo →</span>
    </div>
  </a>
</article>

<style>
  .post-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
    background: var(--color-white);
  }

  .post-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(30, 41, 59, 0.1);
  }

  .post-card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
  }

  .post-card-link:hover { text-decoration: none; }

  .post-card-image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .post-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }

  .post-card:hover .post-card-image img {
    transform: scale(1.04);
  }

  .post-card-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #DBEAFE, var(--color-light));
  }

  .post-card-body {
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .post-card-date {
    font-size: 0.8rem;
    color: var(--color-gray);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .post-card-title {
    font-size: 1.1rem;
    color: var(--color-dark);
    line-height: 1.3;
  }

  .post-card-desc {
    font-size: 0.9rem;
    color: var(--color-gray);
    line-height: 1.5;
    flex: 1;
    margin: 0;
  }

  .post-card-read {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-top: var(--space-xs);
  }
</style>
