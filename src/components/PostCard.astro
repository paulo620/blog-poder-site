---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  image?: string;
}

const { title, description, pubDate, slug, image } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('pt-BR', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---

<article class="post-card">
  <a href={`/blog/${slug}`} class="card-link" aria-label={`Ler artigo: ${title}`}>
    <div class="img-wrap">
      {image
        ? <img src={image} alt={title} loading="lazy" class="card-img" />
        : <div class="card-placeholder" aria-hidden="true">
            <svg viewBox="0 0 304 171" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <rect width="304" height="171" fill="#0a1628"/>
              <circle cx="80" cy="85" r="80" fill="#00e5cc" fill-opacity="0.08"/>
              <circle cx="224" cy="85" r="70" fill="#af6dff" fill-opacity="0.1"/>
              <circle cx="152" cy="85" r="28" fill="none" stroke="#00e5cc" stroke-width="1" stroke-opacity="0.3"/>
              <circle cx="152" cy="85" r="14" fill="#00e5cc" fill-opacity="0.08"/>
              <text x="152" y="92" text-anchor="middle" fill="#00e5cc" fill-opacity="0.5" font-size="18" font-family="monospace" font-weight="500">PS</text>
            </svg>
          </div>
      }
    </div>
    <div class="card-body">
      <time class="card-date" datetime={pubDate.toISOString()}>{formattedDate}</time>
      <h3 class="card-title">{title}</h3>
      <p class="card-desc">{description}</p>
      <span class="card-more">Ler artigo →</span>
    </div>
  </a>
</article>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    background: var(--g-2);
    backdrop-filter: var(--g-blur);
    -webkit-backdrop-filter: var(--g-blur);
    border: 1px solid var(--g-border);
    border-radius: var(--r-lg);
    box-shadow: var(--g-shadow-card);
    overflow: hidden;
    transition: transform var(--t-slow), border-color var(--t-slow), box-shadow var(--t-slow);
    color: var(--text);
  }

  .post-card:hover {
    transform: translateY(-5px);
    border-color: var(--g-border-strong);
    box-shadow: var(--g-shadow-hover);
  }

  .post-card:hover .card-img,
  .post-card:hover .card-placeholder svg {
    transform: scale(1.04);
  }

  .post-card:hover .card-more {
    color: var(--c-purple);
  }

  .card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .img-wrap {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--g-1);
  }

  .card-img,
  .card-placeholder svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--t-slow);
  }

  .card-body {
    padding: 20px 22px 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  .card-date {
    font-family: var(--f-mono);
    font-size: 0.75rem;
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
    color: var(--text-3);
  }

  .card-title {
    font-family: var(--f-display);
    font-weight: var(--fw-extrabold);
    font-size: var(--fs-card-title);
    line-height: 1.25;
    letter-spacing: var(--ls-tight);
    color: var(--text);
  }

  .card-desc {
    font-family: var(--f-body);
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--text-2);
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
  }

  .card-more {
    font-family: var(--f-display);
    font-weight: var(--fw-semibold);
    font-size: 0.875rem;
    color: var(--c-teal-fg);
    margin-top: 4px;
    transition: color var(--t-fast);
  }
</style>
