---
const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog' },
  { label: 'Sobre', href: '/sobre' },
  { label: 'Contato', href: '/contato' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label="Ir para a página inicial">
      <span class="logo-text">O poder de um site</span>
    </a>

    <button class="menu-toggle" aria-label="Abrir menu" aria-expanded="false" aria-controls="nav-menu">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav id="nav-menu" class="nav" aria-label="Menu principal">
      <ul class="nav-list">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              class:list={['nav-link', { active: currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) }]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <div class="header-actions">
        <a href="/contato" class="btn btn-primary btn-sm">Quero um site</a>
        <button class="theme-toggle" aria-label="Alternar tema" id="theme-toggle">
          <!-- sun icon -->
          <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
          <!-- moon icon -->
          <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector('.menu-toggle') as HTMLButtonElement;
  const nav = document.querySelector('#nav-menu') as HTMLElement;
  toggle?.addEventListener('click', () => {
    const isOpen = nav.classList.toggle('nav--open');
    toggle.setAttribute('aria-expanded', String(isOpen));
  });

  const html = document.documentElement;
  const themeBtn = document.getElementById('theme-toggle') as HTMLButtonElement;

  themeBtn?.addEventListener('click', () => {
    const isDark = html.getAttribute('data-theme') === 'dark';
    const next = isDark ? 'light' : 'dark';
    html.setAttribute('data-theme', next);
    try { localStorage.setItem('theme', next); } catch {}
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg);
    border-bottom: 1px solid var(--g-border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    gap: var(--sp-3);
  }

  .logo {
    flex-shrink: 0;
    text-decoration: none;
  }

  .logo-text {
    font-family: var(--f-display);
    font-weight: var(--fw-extrabold);
    font-size: 1.1rem;
    letter-spacing: var(--ls-tight);
    color: var(--text);
  }

  .logo-dot { color: var(--c-purple); }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
  }

  .nav-link {
    font-family: var(--f-display);
    font-weight: var(--fw-semibold);
    font-size: 0.875rem;
    letter-spacing: -0.01em;
    color: var(--text-2);
    transition: color var(--t-fast);
    padding: 4px 0;
    border-bottom: 1.5px solid transparent;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--text);
    border-bottom-color: var(--c-teal-fg);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }

  .btn-sm {
    padding: 0.5rem 1.1rem;
    font-size: 0.85rem;
  }

  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--r-full);
    background: var(--g-1);
    border: 1px solid var(--g-border);
    cursor: pointer;
    color: var(--text-2);
    transition: background var(--t-fast), color var(--t-fast);
    flex-shrink: 0;
  }

  .theme-toggle:hover {
    background: var(--g-2);
    color: var(--text);
  }

  .icon-sun { display: none; }
  .icon-moon { display: block; }

  :global([data-theme="dark"]) .icon-sun { display: none; }
  :global([data-theme="dark"]) .icon-moon { display: block; }
  :global([data-theme="light"]) .icon-sun { display: block; }
  :global([data-theme="light"]) .icon-moon { display: none; }

  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  .menu-toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--text-2);
    border-radius: 2px;
    transition: all var(--t-fast);
  }

  @media (max-width: 768px) {
    .menu-toggle { display: flex; }

    .nav {
      display: none;
      position: absolute;
      top: 64px;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      background: var(--bg);
      border-bottom: 1px solid var(--g-border);
      padding: var(--sp-2) var(--gutter);
    }

    .nav.nav--open { display: flex; }

    .nav-list {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      width: 100%;
    }

    .nav-link {
      display: block;
      padding: 12px 0;
      font-size: 1rem;
      border-bottom-color: transparent;
      border-bottom-style: none;
      border-bottom: none;
      border-bottom: 1px solid var(--border-sub);
      width: 100%;
    }

    .header-actions {
      width: 100%;
      padding: var(--sp-2) 0;
    }
  }
</style>
