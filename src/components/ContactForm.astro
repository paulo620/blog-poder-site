---
---

<!-- Web3Forms: crie uma conta gratuita em https://web3forms.com e substitua YOUR_ACCESS_KEY_HERE pela sua chave -->
<form
  action="https://api.web3forms.com/submit"
  method="POST"
  class="contact-form"
  id="contact-form"
>
  <input type="hidden" name="access_key" value="YOUR_ACCESS_KEY_HERE" />
  <input type="hidden" name="subject" value="Novo contato pelo blog O poder de um site" />
  <input type="hidden" name="from_name" value="Blog O poder de um site" />
  <input type="checkbox" name="botcheck" class="sr-only" tabindex="-1" autocomplete="off" />

  <div class="form-group">
    <label for="name">Nome <span class="required" aria-hidden="true">*</span></label>
    <input
      type="text"
      id="name"
      name="name"
      placeholder="Seu nome completo"
      required
      autocomplete="name"
    />
  </div>

  <div class="form-group">
    <label for="email">E-mail <span class="required" aria-hidden="true">*</span></label>
    <input
      type="email"
      id="email"
      name="email"
      placeholder="seu@email.com"
      required
      autocomplete="email"
    />
  </div>

  <div class="form-group">
    <label for="message">Mensagem <span class="required" aria-hidden="true">*</span></label>
    <textarea
      id="message"
      name="message"
      rows="5"
      placeholder="Conta um pouco sobre seu negócio e o que você precisa..."
      required
    ></textarea>
  </div>

  <button type="submit" class="btn btn-primary btn-submit">
    <span class="btn-text">Enviar mensagem</span>
    <span class="btn-loading" aria-hidden="true">Enviando...</span>
  </button>

  <div class="form-success" role="alert" aria-live="polite" hidden>
    Mensagem enviada! Entrarei em contato em breve.
  </div>

  <div class="form-error" role="alert" aria-live="polite" hidden>
    Erro ao enviar. Tente novamente ou envie um e-mail diretamente.
  </div>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const success = form.querySelector('.form-success') as HTMLElement;
  const error = form.querySelector('.form-error') as HTMLElement;
  const submitBtn = form.querySelector('.btn-submit') as HTMLButtonElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.classList.add('loading');

    const data = new FormData(form);

    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: data,
      });
      const json = await res.json();

      if (json.success) {
        form.reset();
        success.hidden = false;
        error.hidden = true;
      } else {
        throw new Error('Erro no envio');
      }
    } catch {
      error.hidden = false;
      success.hidden = true;
    } finally {
      submitBtn.disabled = false;
      submitBtn.classList.remove('loading');
    }
  });
</script>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  label {
    font-family: var(--f-display);
    font-weight: var(--fw-semibold);
    font-size: 0.875rem;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  .required { color: var(--c-teal-fg); }

  input, textarea {
    padding: 12px 16px;
    border: 1.5px solid var(--g-border);
    border-radius: var(--r-md);
    font-family: var(--f-body);
    font-size: 1rem;
    color: var(--text);
    background: var(--g-1);
    backdrop-filter: var(--g-blur);
    -webkit-backdrop-filter: var(--g-blur);
    transition: border-color var(--t-fast), box-shadow var(--t-fast), background var(--t-fast);
    width: 100%;
  }

  input::placeholder, textarea::placeholder {
    color: var(--text-3);
  }

  input:hover, textarea:hover {
    border-color: var(--g-border-strong);
    background: var(--g-2);
  }

  input:focus, textarea:focus {
    outline: none;
    border-color: var(--c-teal-fg);
    box-shadow: 0 0 0 3px rgba(0, 229, 204, 0.12);
    background: var(--g-2);
  }

  textarea {
    resize: vertical;
    min-height: 130px;
    line-height: var(--lh-body);
  }

  .btn-submit { align-self: flex-start; min-width: 180px; position: relative; }

  .btn-loading { display: none; }
  .btn-submit.loading .btn-text { display: none; }
  .btn-submit.loading .btn-loading { display: inline; }

  .form-success {
    padding: 14px 18px;
    border-radius: var(--r-md);
    font-weight: var(--fw-semibold);
    background: rgba(99, 208, 89, 0.12);
    border: 1px solid rgba(99, 208, 89, 0.3);
    color: var(--c-green-fg);
  }

  .form-error {
    padding: 14px 18px;
    border-radius: var(--r-md);
    font-weight: var(--fw-semibold);
    background: rgba(248, 79, 46, 0.1);
    border: 1px solid rgba(248, 79, 46, 0.25);
    color: var(--c-red);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
  }
</style>
