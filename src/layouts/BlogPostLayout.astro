---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  image?: string;
  tags?: string[];
}

const { title, description, pubDate, image, tags = [] } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('pt-BR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const readingTimeEstimate = '5 min de leitura';
---

<BaseLayout title={title} description={description} image={image}>
  <article class="post-container">
    <header class="post-header">
      <div class="container">
        {tags.length > 0 && (
          <ul class="tag-list">
            {tags.map(tag => <li class="tag">{tag}</li>)}
          </ul>
        )}
        <h1>{title}</h1>
        <div class="post-meta">
          <time datetime={pubDate.toISOString()}>{formattedDate}</time>
          <span>·</span>
          <span>{readingTimeEstimate}</span>
        </div>
      </div>
    </header>

    {image && (
      <div class="post-image container">
        <img src={image} alt={title} />
      </div>
    )}

    <div class="container prose post-body">
      <slot />
    </div>

    <footer class="post-footer container">
      <a href="/blog" class="back-link">← Voltar para o Blog</a>
      <a href="/contato" class="btn btn-primary">Quero um site assim</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .post-header {
    background-color: var(--color-light);
    padding: var(--space-xl) 0 var(--space-lg);
  }

  .post-header h1 {
    margin: var(--space-xs) 0 var(--space-sm);
    max-width: var(--max-width-prose);
  }

  .post-meta {
    display: flex;
    gap: 0.5rem;
    color: var(--color-gray);
    font-size: 0.9rem;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: var(--space-xs);
  }

  .tag {
    background-color: #DBEAFE;
    color: var(--color-primary);
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
  }

  .post-image {
    margin: var(--space-lg) auto;
  }

  .post-image img {
    width: 100%;
    max-height: 400px;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .post-body {
    max-width: var(--max-width-prose);
    margin: var(--space-lg) auto;
  }

  .post-footer {
    max-width: var(--max-width-prose);
    margin: var(--space-xl) auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  .back-link {
    color: var(--color-gray);
    font-weight: 600;
    font-size: 0.95rem;
  }
</style>
